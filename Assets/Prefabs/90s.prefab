    - target: {fileID: 4594742442862663367, guid: 52b11f8595e8038428304a72cd352802, type: 3}
      propertyPath: letrero
      value: 
      objectReference: {fileID: 9143777563806331674}
    - target: {fileID: 4594742442862663367, guid: 52b11f8595e8038428304a72cd352802, type: 3}
      propertyPath: ordenPin
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4594742442862663367, guid: 52b11f8595e8038428304a72cd352802, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: 615b9628082f4be4aacd4d676f06e19c, type: 3}
    - target: {fileID: 4594742442862663367, guid: 52b11f8595e8038428304a72cd352802, type: 3}
      propertyPath: textoDelPin
      value: "En la \xE9poca de los 90, la UAO fortaleci\xF3 su presencia acad\xE9mica
        con reuniones formales y acuerdos que marcaron el rumbo educativo. La prensa
        comenz\xF3 a destacar su impacto regional, y en 1991, el Auditorio M\xFAltiple
        se convirti\xF3 en sede del campus Champagnat, ampliando la infraestructura.
        En 1992, se celebraron 20 a\xF1os de historia con eventos especiales, un
        video institucional y la participaci\xF3n de fundadores, directivos y estudiantes."
      objectReference: {fileID: 0}
