    - target: {fileID: 4594742442862663367, guid: 52b11f8595e8038428304a72cd352802, type: 3}
      propertyPath: textoDelPin
      value: "En 1997, el evento \u201CCaf\xE9 Cuatro con Champagnat\u201D abri\xF3
        espacios de di\xE1logo institucional. Se publicaron art\xEDculos que comunicaban
        el progreso del proyecto y se fortalecieron redes internas para ejecutar
        el plan de construcci\xF3n. En 1998, los informes mostraban el avance f\xEDsico
        del campus, desde los cimientos hasta estructuras visibles. Se cre\xF3 el
        Centro de Servicios de Video.\r\n"
      objectReference: {fileID: 0}
